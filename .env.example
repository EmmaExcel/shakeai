# ===========================================
# Shake Cursor SDK - Environment Variables
# ===========================================

# -------------------------------------------
# API Server Configuration
# -------------------------------------------

# Port the API server listens on
PORT=8787

# Admin token for accessing /admin/* routes
ADMIN_TOKEN=shake-debug-token

# -------------------------------------------
# Model Provider Configuration
# -------------------------------------------

# OpenRouter API key (for OpenRouter model routing)
OPENROUTER_API_KEY=

# OpenRouter referer header (default: https://shakecursor.com)
OPENROUTER_REFERER=https://shakecursor.com

# OpenRouter app title (appears in API headers)
OPENROUTER_APP_TITLE=Shake Cursor SDK

# Default OpenRouter model (default: qwen/qwen3-coder:free)
DEFAULT_OPENROUTER_MODEL=qwen/qwen3-coder:free

# Gemini API key (for Google Gemini models)
GEMINI_API_KEY=

# Default Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------
# Ollama Configuration (Local LLM serving)
# -------------------------------------------

# Ollama API endpoint for local model serving
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default embedding model for RAG
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -------------------------------------------
# Rate Limiting Configuration
# -------------------------------------------

# Requests per second allowed per site (default: 5)
RATE_LIMIT_REQUESTS=5

# Burst capacity (allow burst of this many requests, default: 10)
RATE_LIMIT_BURST_CAPACITY=10

# Window size for rate limiting in ms (default: 1000ms)
RATE_LIMIT_WINDOW_MS=1000

# -------------------------------------------
# RAG / Vector Search Configuration
# -------------------------------------------

# Path to vector embeddings index
RAG_INDEX_PATH=./server/data/demo-docs.vectors.json

# Default number of chunks to retrieve (topK)
RAG_TOP_K=4

# RAG enabled by default? Set false for direct queries only
RAG_ENABLED=false

# -------------------------------------------
# Logging Configuration
# -------------------------------------------

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Logs directory
LOG_DIR=./server/logs

# Max log file size in MB (0 = unlimited)
LOG_MAX_SIZE_MB=10

# Log retention days
LOG_RETENTION_DAYS=30

# -------------------------------------------
# Security Configuration
# -------------------------------------------

# Enable CORS preflight caching? (true/false)
CORS_PREFLIGHT_CACHE=false

# Maximum request body size in bytes (default: 1MB)
MAX_BODY_SIZE=1048576

# Request timeout in ms (default: 30000ms = 30s)
REQUEST_TIMEOUT_MS=30000

# -------------------------------------------
# Performance Configuration
# -------------------------------------------

# Enable caching for repeated queries? (true/false)
ENABLE_CACHING=false

# Cache TTL in seconds (when caching enabled)
CACHE_TTL_SECONDS=300

# Max cached entries (when caching enabled)
CACHE_MAX_ENTRIES=100

# -------------------------------------------
# Custom Model Configuration (if using custom provider)
# -------------------------------------------

# Custom model endpoint URL
CUSTOM_MODEL_ENDPOINT=

# Custom model headers (JSON format)
CUSTOM_MODEL_HEADERS={}
